<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test tooling, not shipped: an allocation trace (dotnet-trace .nettrace with GC AllocationTick
       events) to allocs.tsv for scripts/alloc-compare.py. Built on its own:
       dotnet build tools/AllocTrace -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>
</Project>
