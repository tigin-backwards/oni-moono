<Project Sdk="Microsoft.NET.Sdk">
  <!-- A test mod (KMod) that times the Timelapser's snapshots and colony previews: each stage's
       main-thread and worker time, the longest frames, peak memory and the file written
       (tests/e2e/timelapse-async-snapshots.yaml, `test_mods`). OniManaged is the game's Managed
       folder. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OniManaged Condition="'$(OniManaged)' == ''">$(OniGameDir)/OxygenNotIncluded_Data/Managed</OniManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(OniManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(OniManaged)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="mod.yaml;mod_info.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
