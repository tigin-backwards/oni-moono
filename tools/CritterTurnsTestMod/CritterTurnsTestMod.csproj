<Project Sdk="Microsoft.NET.Sdk">
  <!-- A test mod (KMod) that builds sealed rooms in the early-base fixture's rock: gas-eating
       critters, and enough others that brain turns are scarce, for brain-rate's critter turns
       (issue #85; tests/e2e/issue-85-critters-excrete.yaml, `test_mods`). OniManaged is the
       game's Managed folder. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OniManaged Condition="'$(OniManaged)' == ''">$(OniGameDir)/OxygenNotIncluded_Data/Managed</OniManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(OniManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(OniManaged)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="mod.yaml;mod_info.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
