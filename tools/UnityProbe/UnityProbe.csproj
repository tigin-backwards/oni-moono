<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SemanticsProbe</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OniManaged Condition="'$(OniManaged)' == ''">$(HOME)/projects/oni-linux/OxygenNotIncluded_Data/Managed</OniManaged>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(OniManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(OniManaged)/0Harmony.dll" Private="false" />
    <Reference Include="$(OniManaged)/Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
  <!-- MissingTypes.cs is built against ProbeGone v1; the mod folder gets v2 (Gone/v2), which
       lacks the types and members v1 has. KindChange.cs runs Kind/Cases, built against ProbeKind
       v1; the mod folder gets v2 (Kind/v2), where v1's struct is a class and its class a struct. -->
  <ItemGroup>
    <Compile Remove="Gone/**" />
    <Compile Remove="Kind/**" />
    <Compile Remove="Binding/**" />
    <ProjectReference Include="Gone/v1/ProbeGoneV1.csproj" />
    <ProjectReference Include="Kind/Cases/ProbeKindCases.csproj" />
  </ItemGroup>
</Project>

