<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <RootNamespace>OniMoono.Tests</RootNamespace>
    <!-- Harmony records its patches with BinaryFormatter (as in the host). -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" />
    <!-- The game's Newtonsoft.Json 7 needs its CAS types (as in the host). -->
    <PackageReference Include="System.Security.Permissions" />
    <!-- PathGridPagesTests rewrites the game's Assembly-CSharp as the host does. -->
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>
  <ItemGroup>
    <!-- What the tests need of the game install, and the skips without it (GameInstall). -->
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine is process-global, like Unity's: tests run one at a time. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TestData/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OniMoono.UnityEngine/OniMoono.UnityEngine.csproj" />
    <ProjectReference Include="../../src/OniMoono.Desktop/OniMoono.Desktop.csproj" />
    <ProjectReference Include="../../src/UnityEngine.UI/UnityEngine.UI.csproj" />
    <ProjectReference Include="../../src/Unity.TextMeshPro/Unity.TextMeshPro.csproj" />
    <ProjectReference Include="../../src/Unity.Timeline/Unity.Timeline.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host's settings precedence and file (PlayerSettingsTests): plain .NET, compiled in. -->
    <Compile Include="../../src/OniMoono.Host/PlayerSettings.cs" Link="Host/PlayerSettings.cs" />
    <!-- The GPU option's decisions and its native environment (GpuChoiceTests). -->
    <Compile Include="../../src/OniMoono.Host/GpuChoice.cs" Link="Host/GpuChoice.cs" />
    <Compile Include="../../src/OniMoono.Host/DxgiFaultOption.cs" Link="Host/DxgiFaultOption.cs" />
    <Compile Include="../../src/OniMoono.Host/NativeCrashTestOption.cs" Link="Host/NativeCrashTestOption.cs" />
    <!-- The garbage collection option's decisions (GcModeTests). -->
    <Compile Include="../../src/OniMoono.Host/GcMode.cs" Link="Host/GcMode.cs" />
    <!-- SIGTERM and SIGINT quit at a frame boundary, with a deadline (QuitSignalsTests). -->
    <Compile Include="../../src/OniMoono.Host/QuitSignals.cs" Link="Host/QuitSignals.cs" />
    <!-- The main menu's update check: channels, tags and notes (UpdateCheckTests). -->
    <Compile Include="../../src/OniMoono.Host/UpdateCheck.cs" Link="Host/UpdateCheck.cs" />
    <!-- Unity's player arguments, read or ignored (UnityArgumentsTests). -->
    <Compile Include="../../src/OniMoono.Host/UnityArguments.cs" Link="Host/UnityArguments.cs" />
    <!-- The standalone launch and the versioned install (LaunchTests, InstallTests). -->
    <Compile Include="../../src/OniMoono.Host/Launch/*.cs" Link="Host/Launch/%(Filename)%(Extension)" />
    <Compile Include="../../src/OniMoono.Host/Install/*.cs" Link="Host/Install/%(Filename)%(Extension)" />
    <Compile Include="../../src/OniMoono.GameTweaks/MoonoItemMarker.cs" Link="GameTweaks/MoonoItemMarker.cs" />
    <!-- The player's options and the game's command line (GameCommandLineTests). -->
    <Compile Include="../../src/OniMoono.Host/Options.cs" Link="Host/Options.cs" />
    <Compile Include="../../src/OniMoono.Host/GameCommandLine.cs" Link="Host/GameCommandLine.cs" />
    <Compile Include="../../src/OniMoono.Host/ScriptedInput.cs" Link="Host/ScriptedInput.cs" />
    <!-- What the Windows Restarter starts again, and its command line (RestartCommandTests). -->
    <Compile Include="../../src/OniMoono.Restarter/RestartCommand.cs" Link="Restarter/RestartCommand.cs" />
    <!-- The Moono Tweaks catalog (GameTweakCatalogTests; BackgroundSave names itself from it). -->
    <Compile Include="../../src/OniMoono.Host/GameTweaks/GameTweakNames.cs" Link="Host/GameTweakNames.cs" />
    <Compile Include="../../src/OniMoono.Host/GameTweaks/TweakStrings.cs" Link="Host/TweakStrings.cs" />
    <!-- When post-load-gc collects (PostLoadGcGateTests). -->
    <Compile Include="../../src/OniMoono.Host/GameTweaks/PostLoadGcGate.cs" Link="Host/PostLoadGcGate.cs" />
    <!-- compact-nav-links' store (NavGridLinksTests). -->
    <Compile Include="../../src/OniMoono.Host/NavGridLinks.cs" Link="Host/NavGridLinks.cs" />
    <!-- paged-path-grids' tables and the rewrite of PathGrid (PathGridPagesTests). -->
    <Compile Include="../../src/OniMoono.Host/PathGridPages.cs" Link="Host/PathGridPages.cs" />
    <Compile Include="../../src/OniMoono.Host/PathGridPagesRewrite.cs" Link="Host/PathGridPagesRewrite.cs" />
    <Compile Include="../../src/OniMoono.Host/CilBranches.cs" Link="Host/CilBranches.cs" />
    <!-- The brain-rate game tweak's allowance (BrainRateAllowanceTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/BrainRateAllowance.cs" Link="GameTweaks/BrainRateAllowance.cs" />
    <!-- A tweak written for another game version is off; the checks and the install (TweakChecksTests). -->
    <Compile Include="../../src/OniMoono.Host/GameTweaks/GameMemberAttribute.cs" Link="Host/GameMemberAttribute.cs" />
    <Compile Include="../../src/OniMoono.Host/GameTweaks/TweakMetadata.cs" Link="Host/TweakMetadata.cs" />
    <Compile Include="../../src/OniMoono.Host/GameTweaks/TweakChecks.cs" Link="Host/TweakChecks.cs" />
    <Compile Include="../../src/OniMoono.Host/GameTweaks/TweakInstall.cs" Link="Host/TweakInstall.cs" />
    <!-- The tweaks' call-site transpilers run after mods' (CallSiteRerouteTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/CallSiteReroute.cs" Link="GameTweaks/CallSiteReroute.cs" />
    <!-- The path-probe-repair game tweak's search (ProbeRepairTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/ProbeRepairCore.cs" Link="GameTweaks/ProbeRepairCore.cs" />
    <Compile Include="../../src/OniMoono.GameTweaks/FetchByCellCore.cs" Link="GameTweaks/FetchByCellCore.cs" />
    <!-- The instant-reachability game tweak's crossings, index and coverage (InstantReachabilityTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/ReachabilityIndex.cs" Link="GameTweaks/ReachabilityIndex.cs" />
    <!-- The mod overlaps with the tweaks: grading, the log and the tooltips (ModOverlapsTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/ModOverlapsCore.cs" Link="GameTweaks/ModOverlapsCore.cs" />
    <!-- The fast-load-screen game tweak's header memo and read-ahead (HeaderReadsTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/HeaderReads.cs" Link="GameTweaks/HeaderReads.cs" />
    <!-- The fix-load-screen-clicks game tweak's check for the bug (LoadScreenClickBugTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/LoadScreenClickBug.cs" Link="GameTweaks/LoadScreenClickBug.cs" />
    <!-- The fast-jobs game tweak's worker wakes (WorkerWakesTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/WorkerWakes.cs" Link="GameTweaks/WorkerWakes.cs" />
    <!-- Frame stats' timing of the game's update (FrameStatsTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/GameFrameStats.cs" Link="GameTweaks/GameFrameStats.cs" />
    <!-- The fast-symbol-overrides game tweak's block bookkeeping (OverrideBlockLogTests). -->
    <Compile Include="../../src/OniMoono.GameTweaks/OverrideBlockLog.cs" Link="GameTweaks/OverrideBlockLog.cs" />
    <!-- The background-save game tweak's writes (BackgroundSaveTests), with the game's zlib. -->
    <Compile Include="../../src/OniMoono.Host/GameTweaks/BackgroundSave.cs" Link="Host/BackgroundSave.cs" />
    <Reference Include="Ionic.Zip">
      <HintPath>$(OniGameDir)/OxygenNotIncluded_Data/Managed/Ionic.Zip.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The game's Harmony, as mods patch the engine with it (TmpInputSetupTests). -->
    <Reference Include="0Harmony">
      <HintPath>$(OniGameDir)/OxygenNotIncluded_Data/Managed/0Harmony.dll</HintPath>
    </Reference>
    <!-- Patched instantiations of shared generic code follow it in Harmony's order (SharedGenericsTests). -->
    <Compile Include="../../src/OniMoono.Host/SharedGenerics.cs" Link="Host/SharedGenerics.cs" />
    <Compile Include="../../src/OniMoono.Host/SharedGenericsOrderCheck.cs" Link="Host/SharedGenericsOrderCheck.cs" />
    <!-- Delegates through the game's Newtonsoft.Json as Mono serializes them (MonoDelegateSerializationTests). -->
    <Compile Include="../../src/OniMoono.Host/MonoDelegateSerialization.cs" Link="Host/MonoDelegateSerialization.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(OniGameDir)/OxygenNotIncluded_Data/Managed/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
