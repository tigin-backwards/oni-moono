msgstr ""

#. The line under the title (fast-offset-tables)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OFFSET_TABLES.EFFECT"
msgid "Where an item can be picked up from is rechecked only when its surroundings change."
msgstr ""

#. Tooltip: how it works (fast-offset-tables)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OFFSET_TABLES.DETAIL"
msgid "Fetch updates recheck only the items whose work spots can have changed."
msgstr ""

#. Row title (fast-partitioner-cleanup)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTITIONER_CLEANUP.TITLE"
msgid "Faster spatial index cleanup"
msgstr ""

#. The line under the title (fast-partitioner-cleanup)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTITIONER_CLEANUP.EFFECT"
msgid "The once-a-second tidy-up of what is where looks only at what was removed."
msgstr ""

#. Tooltip: how it works (fast-partitioner-cleanup)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTITIONER_CLEANUP.DETAIL"
msgid "The spatial index's cleanup visits only the entries that were removed."
msgstr ""

#. Row title (fast-conveyor-paths)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_CONVEYOR_PATHS.TITLE"
msgid "Faster conveyor rebuilds"
msgstr ""

#. The line under the title (fast-conveyor-paths)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_CONVEYOR_PATHS.EFFECT"
msgid "Building or removing conveyor rails no longer stalls the game."
msgstr ""

#. Tooltip: how it works (fast-conveyor-paths)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_CONVEYOR_PATHS.DETAIL"
msgid "The rails' network rebuild finds its routes from an index instead of searching every kept route again."
msgstr ""

#. Tooltip: the measured gain (fast-conveyor-paths)
msgctxt "STRINGS.MOONO.TWEAKS.GAINS.CONVEYOR"
msgid "No hitch on rail edits (was 0.05–0.5 s)"
msgstr ""

#. Row title (compact-nav-links)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_NAV_LINKS.TITLE"
msgid "Compact navigation links"
msgstr ""

#. The line under the title (compact-nav-links)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_NAV_LINKS.EFFECT"
msgid "The map of where Duplicants and critters can move takes a fraction of the memory."
msgstr ""

#. Tooltip: how it works (compact-nav-links)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_NAV_LINKS.DETAIL"
msgid "Each pathfinding grid keeps a cell's moves packed together instead of a fixed row of slots for every cell of the map; the pathfinder reads the same moves in the same order."
msgstr ""

#. Row title (fast-smi-lookups)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SMI_LOOKUPS.TITLE"
msgid "Faster state machine lookups"
msgstr ""

#. The line under the title (fast-smi-lookups)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SMI_LOOKUPS.EFFECT"
msgid "Finding one of an object's state machines no longer searches all of them each time."
msgstr ""

#. Tooltip: how it works (fast-smi-lookups)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SMI_LOOKUPS.DETAIL"
msgid "Each object remembers which of its state machines answered each lookup until its list of state machines changes."
msgstr ""

#. Row title (paged-path-grids)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PAGED_PATH_GRIDS.TITLE"
msgid "Paged path grids"
msgstr ""

#. The line under the title (paged-path-grids)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PAGED_PATH_GRIDS.EFFECT"
msgid "Each Duplicant's map of path costs takes memory only where it can walk."
msgstr ""

#. Tooltip: how it works (paged-path-grids)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PAGED_PATH_GRIDS.DETAIL"
msgid "A Duplicant's path grid covers the whole map; it is kept in small pages made the first time a probe writes there, and the parts never written read as the empty grid did. The pathfinder reads the same values."
msgstr ""

#. Row title (shared-duplicates)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SHARED_DUPLICATES.TITLE"
msgid "Share identical data"
msgstr ""

#. The line under the title (shared-duplicates)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SHARED_DUPLICATES.EFFECT"
msgid "Names repeated across a colony's reports and other identical data are kept once, using less memory."
msgstr ""

#. Tooltip: how it works (shared-duplicates)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SHARED_DUPLICATES.DETAIL"
msgid "While a save loads, every copy of the same text (Duplicants' and critters' names in each day's report) becomes one; buildings with the same footprint share one table of the spots they are worked from, and work animations left at their defaults share one list. Nothing is written into them, so the game reads the same values."
msgstr ""

#. Tooltip: the measured gain (shared-duplicates)
msgctxt "STRINGS.MOONO.TWEAKS.GAINS.SHARED"
msgid "~0.3 GB less memory on a late-game colony"
msgstr ""

#. Row title (compact-report-history)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_REPORT_HISTORY.TITLE"
msgid "Compact report history"
msgstr ""

#. The line under the title (compact-report-history)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_REPORT_HISTORY.EFFECT"
msgid "Past days' reports take a fraction of the memory."
msgstr ""

#. Tooltip: how it works (compact-report-history)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_REPORT_HISTORY.DETAIL"
msgid "The notes of every day's report but today's are kept in flat arrays instead of a table for each entry; the reports screen and saves read the same notes in the same order."
msgstr ""

#. Tooltip: the measured gain (compact-report-history)
msgctxt "STRINGS.MOONO.TWEAKS.GAINS.REPORTS"
msgid "~0.9 GB less memory on a late-game colony; loading ~1 s faster"
msgstr ""

#. Row title (fetch-by-cell)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FETCH_BY_CELL.TITLE"
msgid "Fetch checks by pile"
msgstr ""

#. The line under the title (fetch-by-cell)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FETCH_BY_CELL.EFFECT"
msgid "Duplicants looking for things to fetch check each pile of identical items once, not item by item."
msgstr ""

#. Tooltip: how it works (fetch-by-cell)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FETCH_BY_CELL.DETAIL"
msgid "Keeps the best item of each pile up to date as items move, are reserved or spoil, and finds the path to each pile once. Items on worlds a Duplicant can't reach are skipped. Within a pile of items that are the same in every way the game compares, a Duplicant may take another one than in the original. Off while a mod changes how Duplicants choose what to fetch."
msgstr ""

#. Tooltip: the measured gain (fetch-by-cell)
msgctxt "STRINGS.MOONO.TWEAKS.GAINS.FETCH"
msgid "Fetch updates ~8× shorter on a colony with big piles (3.1–3.4 → 0.4 ms each)"
msgstr ""

#. Section heading (shown in capitals)
msgctxt "STRINGS.MOONO.TWEAKS.GROUPS.GRAPHICS"
msgid "Graphics & overlays"
msgstr ""

#. Row title (fast-anim-events)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_EVENTS.TITLE"
msgid "Faster animation events"
msgstr ""

#. The line under the title (fast-anim-events)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_EVENTS.EFFECT"
msgid "Animations check their sound and effect cues with less work."
msgstr ""

#. Tooltip: how it works (fast-anim-events)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_EVENTS.DETAIL"
msgid "Keeps a compact copy of what each playing animation's per-frame event check reads."
msgstr ""

#. Row title (fast-anim-cleanup)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_CLEANUP.TITLE"
msgid "Faster animation cleanup"
msgstr ""

#. The line under the title (fast-anim-cleanup)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_CLEANUP.EFFECT"
msgid "Removed animations are swept out only where one was removed."
msgstr ""

#. Tooltip: how it works (fast-anim-cleanup)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_CLEANUP.DETAIL"
msgid "The sweep for destroyed animations skips grid chunks that can't hold any."
msgstr ""

#. Row title (fast-anim-batches)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_BATCHES.TITLE"
msgid "Parallel animation uploads"
msgstr ""

#. The line under the title (fast-anim-batches)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_BATCHES.EFFECT"
msgid "Animation data for the graphics card is prepared on several threads."
msgstr ""

#. Tooltip: how it works (fast-anim-batches)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_BATCHES.DETAIL"
msgid "Animation batches write their instance and symbol data on worker threads, the rest in the game's order."
msgstr ""

#. Row title (fast-symbol-overrides)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SYMBOL_OVERRIDES.TITLE"
msgid "Fewer animation uploads"
msgstr ""

#. The line under the title (fast-symbol-overrides)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SYMBOL_OVERRIDES.EFFECT"
msgid "Swapped animation parts are re-sent to the graphics card only when they change."
msgstr ""

#. Tooltip: how it works (fast-symbol-overrides)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SYMBOL_OVERRIDES.DETAIL"
msgid "Unchanged symbol-override blocks of Duplicants and buildings aren't uploaded again."
msgstr ""

#. Row title (fast-overlays)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OVERLAYS.TITLE"
msgid "Faster overlays"
msgstr ""

#. The line under the title (fast-overlays)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OVERLAYS.EFFECT"
msgid "Overlays skip rereading what can't have changed since the last frame."
msgstr ""

#. Tooltip: how it works (fast-overlays)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OVERLAYS.DETAIL"
msgid "Temperature passes over buildings out of view without reading them, power asks each circuit's load once a frame, the rest keep what their targets' visits read."
msgstr ""

#. Tooltip: the measured gain (fast-overlays)
msgctxt "STRINGS.MOONO.TWEAKS.GAINS.OVERLAYS"
msgid "Temperature overlay ~40% cheaper"
msgstr ""

#. Row title (fast-overlay-textures)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OVERLAY_TEXTURES.TITLE"
msgid "Overlay texture cleanup"
msgstr ""

#. The line under the title (fast-overlay-textures)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OVERLAY_TEXTURES.EFFECT"
msgid "Opening and closing overlays no longer piles up video memory."
msgstr ""

#. Tooltip: how it works (fast-overlay-textures)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OVERLAY_TEXTURES.DETAIL"
msgid "The screen-sized textures the game remakes on each coloured overlay toggle are freed, instead of kept until the next load (about 18 MB a toggle at 1024×768)."
msgstr ""

#. Section heading (shown in capitals)
msgctxt "STRINGS.MOONO.TWEAKS.GROUPS.CHANGES_GAMEPLAY"
msgid "Changes gameplay"
msgstr ""

#. Row title (path-probe-repair)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PATH_PROBE_REPAIR.TITLE"
msgid "Incremental path probes"
msgstr ""

#. The line under the title (path-probe-repair)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PATH_PROBE_REPAIR.EFFECT"
msgid "Duplicants' path checks redo only what changed in the world, using less CPU."
msgstr ""

#. Tooltip: how it works (path-probe-repair)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PATH_PROBE_REPAIR.DETAIL"
msgid "Each Duplicant's last path probe is repaired around what changed (digging, building, doors, liquids) instead of searched again from scratch. Costs and reachable cells stay the same; where two routes cost the same, a Duplicant may walk the other one, not the original's. Keeps about 0.9 MB a Duplicant. Off while another mod changes path probing (Fast Track's Cache Paths)."
msgstr ""

#. Row title (instant-reachability)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.INSTANT_REACHABILITY.TITLE"
msgid "Instant reachability checks"
msgstr ""

#. The line under the title (instant-reachability)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.INSTANT_REACHABILITY.EFFECT"
msgid "Duplicants notice a newly opened or blocked path at once, using less CPU."
msgstr ""

#. Tooltip: how it works (instant-reachability)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.INSTANT_REACHABILITY.DETAIL"
msgid "Which errands and items can be reached is rechecked where and when a Duplicant's reach changes, instead of every one of them once a second. The answers are the game's, up to 1 s sooner. Items it can't follow (some mods' own) are still checked every second."
msgstr ""

#. Row title (off-screen-conveyors)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_SCREEN_CONVEYORS.TITLE"
msgid "Lazy unseen conveyor items"
msgstr ""

#. The line under the title (off-screen-conveyors)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_SCREEN_CONVEYORS.EFFECT"
msgid "Items riding rails off screen are placed only when they stop or come into view."
msgstr ""

#. Tooltip: how it works (off-screen-conveyors)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_SCREEN_CONVEYORS.DETAIL"
msgid "The rails carry exactly the same things, but items' positions lag while off screen."
msgstr ""

#. Row title (brain-rate)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.BRAIN_RATE.TITLE"
msgid "Critter and dupe brain updates capped at 30 updates a second"
msgstr ""

#. The line under the title (brain-rate)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.BRAIN_RATE.EFFECT"
msgid "Critters and dupes would otherwise update on every frame. This trims that bookkeeping above 30 fps."
msgstr ""

#. Tooltip: how it works (brain-rate)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.BRAIN_RATE.DETAIL"
msgid "The game updates 1 Duplicant and 5 critter brains every rendered frame; this caps them at 30 and 150 a second, spread over frames. One that just finished an errand or is under threat still gets the next update. Saves time only above 30 fps."
msgstr ""

#. Section heading (shown in capitals)
msgctxt "STRINGS.MOONO.TWEAKS.GROUPS.BUG_FIXES"
msgid "Bug fixes"
msgstr ""

#. Row title (off-world-fallers)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_WORLD_FALLERS.TITLE"
msgid "Land items lost below a world"
msgstr ""

#. The line under the title (off-world-fallers)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_WORLD_FALLERS.EFFECT"
msgid "Items that fall out the bottom of a world (a rocket's chute) stop falling forever."
msgstr ""

#. Tooltip: how it works (off-world-fallers)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_WORLD_FALLERS.DETAIL"
msgid "A bug in the game: they hang just below the world, stepped as falling every tick. This lands them where they hang."
msgstr ""

#. Row title (fix-load-screen-clicks)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_LOAD_SCREEN_CLICKS.TITLE"
msgid "Open a colony once on the Load screen"
msgstr ""

#. The line under the title (fix-load-screen-clicks)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_LOAD_SCREEN_CLICKS.EFFECT"
msgid "After Load more, a click on a colony no longer builds its list of saves again for every refresh."
msgstr ""

#. Tooltip: how it works (fix-load-screen-clicks)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_LOAD_SCREEN_CLICKS.DETAIL"
msgid "A bug in the game's own code: each Load more adds another copy of the click to the colonies already shown, so one click builds the colony once for every refresh, and the last one stays on screen. With this, one click builds it once and logs once; the screen ends up the same."
msgstr ""

#. Row title (fix-endless-sounds)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_ENDLESS_SOUNDS.TITLE"
msgid "Stop sounds that never end"
msgstr ""

#. The line under the title (fix-endless-sounds)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_ENDLESS_SOUNDS.EFFECT"
msgid "An eating Pip no longer leaves sounds playing forever, which in time froze the game."
msgstr ""

#. Tooltip: how it works (fix-endless-sounds)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_ENDLESS_SOUNDS.DETAIL"
msgid "A bug in the game's sound data: the adult Pip's eating loop, and the debris left by a self-destructed rocket, start a new copy of a looping sound on every loop and never stop one. With this they play as the baby Pip's does: one copy while the animation runs, stopped when it ends."
msgstr ""

#. Row title (fix-sound-piles)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_SOUND_PILES.TITLE"
msgid "Cap repeated sounds in one tile"
msgstr ""

#. The line under the title (fix-sound-piles)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_SOUND_PILES.EFFECT"
msgid "Hundreds of critters in one tile no longer freeze the game with their sounds."
msgstr ""

#. Tooltip: how it works (fix-sound-piles)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_SOUND_PILES.DETAIL"
msgid "When more than 3 copies of the same sound start in the same tile in the same frame, the rest are skipped. A big pile of critters sounds quieter; anywhere else this almost never happens. UI and looping sounds are never skipped."
msgstr ""

#. Row title (fix-geothermal-vents)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_GEOTHERMAL_VENTS.TITLE"
msgid "Count all a geothermal vent emits"
msgstr ""

#. The line under the title (fix-geothermal-vents)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_GEOTHERMAL_VENTS.EFFECT"
msgid "A geothermal vent's kg remaining goes down as it vents, instead of stalling while it keeps emitting."
msgstr ""

#. Tooltip: how it works (fix-geothermal-vents)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_GEOTHERMAL_VENTS.DETAIL"
msgid "A bug in the game's own code, fixed in its next update: a vent reads what it emitted at a time of its own, and at high frame rates it often reads nothing, so it vents on and on and clogs its pipes. With this, as in that update, it counts what it emits after every step of the simulation."
msgstr ""

#. Row title (fix-timelapse-snapshots)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_TIMELAPSE_SNAPSHOTS.TITLE"
msgid "Correct daily colony snapshots"
msgstr ""

#. The line under the title (fix-timelapse-snapshots)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_TIMELAPSE_SNAPSHOTS.EFFECT"
msgid "Colony snapshots saved each cycle no longer get vertical stripes, squeezed lights or stray effects."
msgstr ""

#. Tooltip: how it works (fix-timelapse-snapshots)
msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_TIMELAPSE_SNAPSHOTS.DETAIL"
msgid "A bug in the game's own code: a snapshot is drawn into a narrow image, but the build grid, the lights and the heat, cold and dust effects are set up for the screen's wider view. With a building picked for placement, the grid draws stripes over the left of the image. With this, they are drawn for the snapshot's own view."
msgstr ""

#. The loader mod's dialog in the original game: its title
msgctxt "STRINGS.MOONO.LOADER.TITLE"
msgid "Play with Moono?"
msgstr ""

#. The dialog's first line, above three numbered steps
msgctxt "STRINGS.MOONO.LOADER.INTRO"
msgid "Moono makes Oxygen Not Included run faster. To play with it:"
msgstr ""

#. Step 1, above the launch-option line; Copy launch option is the COPY button
msgctxt "STRINGS.MOONO.LOADER.STEP_COPY"
msgid "Click Copy launch option. This installs Moono and copies:"
msgstr ""

#. Step 2
msgctxt "STRINGS.MOONO.LOADER.STEP_PASTE"
msgid "In Steam, right-click Oxygen Not Included → Properties → Launch Options, and paste."
msgstr ""

#. Step 3
msgctxt "STRINGS.MOONO.LOADER.STEP_RESTART"
msgid "Quit the game and press Play."
msgstr ""

#. A small line under the steps
msgctxt "STRINGS.MOONO.LOADER.DISABLE_HINT"
msgid "To stop seeing this, disable the Moono mod."
msgstr ""

#. The dialog's button that closes it
msgctxt "STRINGS.MOONO.LOADER.NOT_NOW"
msgid "Not now"
msgstr ""

#. The dialog's main button
msgctxt "STRINGS.MOONO.LOADER.COPY"
msgid "Copy launch option"
msgstr ""

#. The main button's text once it has copied the line
msgctxt "STRINGS.MOONO.LOADER.COPIED"
msgid "Copied ✓"
msgstr ""

#. Step 1's text once the button installed Moono and copied the line
msgctxt "STRINGS.MOONO.LOADER.INSTALLED"
msgid "Moono installed. Launch option copied."
msgstr ""

#. Step 1's text when the install fails; {0}: why (in English)
msgctxt "STRINGS.MOONO.LOADER.FAILED"
msgid "Moono could not be installed: {0}"
msgstr ""

#. The button on the item's row in the Mods screen that shows the dialog
msgctxt "STRINGS.MOONO.LOADER.MODS_BUTTON"
msgid "Play with Moono"
msgstr ""

#. That button's tooltip
msgctxt "STRINGS.MOONO.LOADER.MODS_TIP"
msgid "Install Moono and copy the launch option for Steam"
msgstr ""
