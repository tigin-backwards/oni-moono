# Moono's strings in Simplified Chinese: the Moono Tweaks screen and the Workshop loader mod.
# The Moono Tweaks screen's translation by hao7259 (https://github.com/hao7259), from PR #38.
# msgctxt: the string's key; msgid: the English it was translated from (translations/moono.pot).
msgid ""
msgstr ""
"Language: zh\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgctxt "STRINGS.MOONO.TWEAKS.UI.TITLE"
msgid "MOONO TWEAKS"
msgstr "MOONO 调整项"

msgctxt "STRINGS.MOONO.TWEAKS.UI.CHANGES_APPLY_ON_RESTART"
msgid "Changes apply when the game restarts."
msgstr "更改将在游戏重启后生效。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.RESET_TO_DEFAULTS"
msgid "RESET TO DEFAULTS"
msgstr "恢复默认"

msgctxt "STRINGS.MOONO.TWEAKS.UI.RESTART_TO_APPLY"
msgid "RESTART TO APPLY"
msgstr "重启以应用"

msgctxt "STRINGS.MOONO.TWEAKS.UI.CHANGES_GAMEPLAY_NOTE"
msgid "These trade a little exactness for speed. Most are off by default."
msgstr "这些选项会牺牲一点精确性来换取速度。大多默认关闭。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.BUG_FIXES_NOTE"
msgid "These fix bugs in the game, so they change what the original does."
msgstr "这些选项修复游戏自身的错误，因此会改变原版的行为。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.NO_MATCHES"
msgid "No tweaks match the search."
msgstr "没有与搜索匹配的调整项。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.LAUNCH_OPTION"
msgid "LAUNCH OPTION"
msgstr "启动选项"

msgctxt "STRINGS.MOONO.TWEAKS.UI.LAUNCH_OPTION_LINE"
msgid "Launch option: {0}"
msgstr "启动选项：{0}"

msgctxt "STRINGS.MOONO.TWEAKS.UI.LOCKED_ON"
msgid "Set by the launch options (on)"
msgstr "由启动选项设置（开）"

msgctxt "STRINGS.MOONO.TWEAKS.UI.LOCKED_OFF"
msgid "Set by the launch options (off)"
msgstr "由启动选项设置（关）"

msgctxt "STRINGS.MOONO.TWEAKS.UI.NOT_AVAILABLE"
msgid "NOT AVAILABLE"
msgstr "不可用"

msgctxt "STRINGS.MOONO.TWEAKS.UI.NOT_AVAILABLE_TIP"
msgid "Not available on this game version."
msgstr "此游戏版本无法使用。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.LOCKED_CHOICE"
msgid "Set by the launch options ({0})"
msgstr "由启动选项设置（{0}）"

msgctxt "STRINGS.MOONO.TWEAKS.UI.NEXT_CHOICE"
msgid "Click for the next choice: {0}"
msgstr "点击切换到下一个选项：{0}"

msgctxt "STRINGS.MOONO.TWEAKS.UI.LIST_SEPARATOR"
msgid ", "
msgstr "、"

msgctxt "STRINGS.MOONO.TWEAKS.UI.SAVE_FAILED"
msgid "The settings could not be saved to {0}:\n{1}"
msgstr "无法将设置保存到 {0}：\n{1}"

msgctxt "STRINGS.MOONO.TWEAKS.UI.SAVED_RESTART"
msgid "Your changes are saved and apply when the game restarts."
msgstr "你的更改已保存，将在游戏重启后生效。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.LATER"
msgid "LATER"
msgstr "稍后"

msgctxt "STRINGS.MOONO.TWEAKS.UI.UPDATE_HEADLINE"
msgid "Moo! An update is available"
msgstr "哞！有新版本了"

msgctxt "STRINGS.MOONO.TWEAKS.UI.UPDATE_MORE"
msgid "…more on the release page"
msgstr "……更多内容见发布页面"

msgctxt "STRINGS.MOONO.TWEAKS.UI.OVERLAP_REWRITES"
msgid "{0} also patches {1} (it rewrites the game's code)."
msgstr "{0} 也修补了 {1}（它会改写游戏的代码）。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.OVERLAP_SKIPS"
msgid "{0} also patches {1} (it can skip the game's code)."
msgstr "{0} 也修补了 {1}（它可以跳过游戏的代码）。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.OVERLAP_PATCHES"
msgid "{0} also patches {1}."
msgstr "{0} 也修补了 {1}。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.OVERLAP_STEPS_ASIDE"
msgid "Off while {0} is loaded, as it patches {1}."
msgstr "加载 {0} 时关闭，因为它修补了 {1}。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.OVERLAP_ADVICE"
msgid "If something looks wrong, turn this tweak off."
msgstr "如果有异常，请关闭此调整项。"

msgctxt "STRINGS.MOONO.TWEAKS.UI.OVERLAP_MORE_METHODS"
msgid "{0} and {1} more"
msgstr "{0} 等另外 {1} 个"

msgctxt "STRINGS.MOONO.TWEAKS.UI.OVERLAPS_ONE"
msgid "1 overlap"
msgstr "1 处重叠"

msgctxt "STRINGS.MOONO.TWEAKS.UI.OVERLAPS_MANY"
msgid "{0} overlaps"
msgstr "{0} 处重叠"

msgctxt "STRINGS.MOONO.TWEAKS.UI.OVERLAPS_TIP"
msgid "Some mods patch the same code as Moono's tweaks. Open Moono Tweaks to see which."
msgstr "有些模组修补了与 Moono 调整项相同的代码。打开 Moono 调整项查看是哪些。"

msgctxt "STRINGS.MOONO.TWEAKS.GROUPS.GENERAL"
msgid "General"
msgstr "通用"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SPLASH.TITLE"
msgid "Gassy Moo loading splash"
msgstr "释气海牛加载画面"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SPLASH.EFFECT"
msgid "Gassy Moos rain over the window while the game starts, with a progress bar."
msgstr "游戏启动时，窗口上会下雨般落下释气海牛，并显示进度条。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.UPDATE_CHECK.TITLE"
msgid "Update check"
msgstr "检查更新"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.UPDATE_CHECK.EFFECT"
msgid "The main menu shows when a newer Moono is out."
msgstr "有新版 Moono 时，主菜单会提示。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.UPDATE_CHECK.DETAIL"
msgid "Asks GitHub for Moono's list of releases (api.github.com) at most once every 6 hours, in the background, sending nothing about you or your game. The answer is kept in the oni-moono data folder. Off: Moono makes no network requests of its own."
msgstr "在后台向 GitHub（api.github.com）获取 Moono 的版本列表，最多每 6 小时一次，不会发送任何关于你或你的游戏的信息。结果保存在 oni-moono 数据文件夹中。关闭后，Moono 自身不会发出任何网络请求。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FRAME_STATS.TITLE"
msgid "Frame stats in the log"
msgstr "日志中的帧统计"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FRAME_STATS.EFFECT"
msgid "Notes where the frame time goes in Player.log, for reporting slowness."
msgstr "在 Player.log 中记录帧时间花在哪里，用于反馈卡顿问题。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FRAME_STATS.DETAIL"
msgid "Every 60 frames."
msgstr "每 60 帧一次。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.LOG_PATHS.TITLE"
msgid "Hide personal paths in the log"
msgstr "隐藏日志中的个人路径"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.LOG_PATHS.EFFECT"
msgid "Your user folder reads %USERPROFILE% or ~ in Player.log, and your account IDs and name are hidden."
msgstr "Player.log 中你的用户文件夹会显示为 %USERPROFILE% 或 ~，你的账号 ID 和名称也会被隐藏。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.LOG_PATHS.DETAIL"
msgid "Mods still get the full text."
msgstr "模组仍能读到完整文本。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.GPU.TITLE"
msgid "Graphics card"
msgstr "显卡"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.GPU.EFFECT"
msgid "For laptops with two GPUs: which one the game draws with. Needs a restart."
msgstr "适用于双显卡笔记本——选择游戏用哪块 GPU 渲染。需要重启。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.GPU.DETAIL"
msgid "Default: as the original game (on Windows the faster, discrete GPU; on Linux the system's choice). Discrete: the faster GPU. Integrated: the power-saving one; on Windows with OpenGL, choose it in Windows' Graphics settings, which win over this. On Linux, on a desktop whose display is on the discrete card, discrete may pick the integrated GPU."
msgstr "默认：与原版游戏相同（Windows 上选较快的独立显卡；Linux 上由系统决定）。独立：较快的 GPU。集成：省电的那块；在 Windows 上使用 OpenGL 时，请在 Windows 的“图形设置”中选择，它的优先级高于此项。在 Linux 上，如果桌面显示输出接在独立显卡上，选“独立”可能会选中集成显卡。"

msgctxt "STRINGS.MOONO.TWEAKS.CHOICES.GPU.DEFAULT"
msgid "default"
msgstr "默认"

msgctxt "STRINGS.MOONO.TWEAKS.CHOICES.GPU.DISCRETE"
msgid "discrete"
msgstr "独立"

msgctxt "STRINGS.MOONO.TWEAKS.CHOICES.GPU.INTEGRATED"
msgid "integrated"
msgstr "集成"

msgctxt "STRINGS.MOONO.TWEAKS.GROUPS.SAVING"
msgid "Saving"
msgstr "存档"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SERIALIZATION.TITLE"
msgid "Faster save writing"
msgstr "更快的存档写入"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SERIALIZATION.EFFECT"
msgid "Autosaves take less time; the save file is the same."
msgstr "自动存档耗时更短；存档文件不变。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SERIALIZATION.DETAIL"
msgid "Writes the colony's numbers without boxing each one in an object."
msgstr "写入殖民地数据时不再把每个数值装箱成对象。"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.SAVE"
msgid "Saving together: autosave freeze ~12 s → ~5 s on a large colony"
msgstr "存档调整项合计：大型殖民地自动存档冻结约 12 秒 → 约 5 秒"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SAVE_TYPE_CHECKS.TITLE"
msgid "Faster save checks"
msgstr "更快的存档检查"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SAVE_TYPE_CHECKS.EFFECT"
msgid "Autosaves skip repeating the same checks for every object."
msgstr "自动存档不再对每个对象重复相同的检查。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SAVE_TYPE_CHECKS.DETAIL"
msgid "Remembers what saving asks about each kind of component instead of asking again for every object."
msgstr "记住每种组件在存档时会被问什么，而不是每个对象都再问一遍。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SAVE_COMPRESSION.TITLE"
msgid "Faster save compression"
msgstr "更快的存档压缩"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SAVE_COMPRESSION.EFFECT"
msgid "Saving and loading take seconds less; files stay compatible, a little larger."
msgstr "存档和读档快几秒；文件保持兼容，但略大一些。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SAVE_COMPRESSION.DETAIL"
msgid "Compresses with .NET's zlib instead of the game's own; the files are about 14% larger."
msgstr "改用 .NET 的 zlib 压缩，而不是游戏自带的；文件大约大 14%。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.BACKGROUND_SAVE.TITLE"
msgid "Background saving"
msgstr "后台存档"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.BACKGROUND_SAVE.EFFECT"
msgid "The save is compressed and written to disk while the game plays on."
msgstr "游戏继续运行时，存档在后台压缩并写入磁盘。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.BACKGROUND_SAVE.DETAIL"
msgid "Compression and the file write move to another thread; quitting waits for them."
msgstr "压缩和写文件移到另一个线程；退出游戏时会等待它们完成。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.NO_SAVE_GC.TITLE"
msgid "No cleanup pause when saving"
msgstr "存档时不再强制清理内存"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.NO_SAVE_GC.EFFECT"
msgid "Skips the memory cleanup the game forces after each save, a pause of its own."
msgstr "跳过游戏每次存档后强制进行的内存清理——那本身也是一次卡顿。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.NO_SAVE_GC.DETAIL"
msgid "Skips the full garbage collection the game asks for after saving."
msgstr "跳过存档后游戏请求的完整垃圾回收。"

msgctxt "STRINGS.MOONO.TWEAKS.GROUPS.SIMULATION"
msgid "Simulation"
msgstr "模拟"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_JOBS.TITLE"
msgid "Faster worker threads"
msgstr "更快的工作线程"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_JOBS.EFFECT"
msgid "Less time lost waking idle worker threads every frame."
msgstr "减少每帧唤醒空闲工作线程的时间损失。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_JOBS.DETAIL"
msgid "Wakes only as many of the game's worker threads as a job has work for, instead of all of them for every job (about 14 a frame)."
msgstr "只唤醒当前任务实际需要的游戏工作线程，而不是每个任务都唤醒全部（每帧约 14 个任务）。"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.JOBS"
msgid "+11% frame rate on a large colony"
msgstr "大型殖民地帧率提升 11%"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SUBLIMATION.TITLE"
msgid "Faster sublimation"
msgstr "更快的升华"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SUBLIMATION.EFFECT"
msgid "Items that can't sublimate (polluted dirt in full gas) are skipped."
msgstr "无法升华的物品（如满气体环境中的污染土）会被跳过。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SUBLIMATION.DETAIL"
msgid "Items already blocked by full gas cells are skipped in one batched update."
msgstr "已被满气体格挡住的物品会合并成一次批量更新跳过。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTICLE_COLLISION.TITLE"
msgid "Faster radbolt collisions"
msgstr "更快的辐射粒子碰撞"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTICLE_COLLISION.EFFECT"
msgid "Radbolts look for each other only where one can be."
msgstr "辐射粒子只在可能有其他粒子的地方互相查找。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTICLE_COLLISION.DETAIL"
msgid "A radbolt skips searching every stored item nearby when no other radbolt is close."
msgstr "附近没有其他辐射粒子时，粒子不再搜索附近所有存储物品。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OFFSET_TABLES.TITLE"
msgid "Faster pickup checks"
msgstr "更快的拾取检查"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OFFSET_TABLES.EFFECT"
msgid "Where an item can be picked up from is rechecked only when its surroundings change."
msgstr "物品可被拾取的位置只在其周围环境变化时才重新检查。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_OFFSET_TABLES.DETAIL"
msgid "Fetch updates recheck only the items whose work spots can have changed."
msgstr "搬运更新只重新检查工作点可能发生变化的物品。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTITIONER_CLEANUP.TITLE"
msgid "Faster spatial index cleanup"
msgstr "更快的空间索引清理"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTITIONER_CLEANUP.EFFECT"
msgid "The once-a-second tidy-up of what is where looks only at what was removed."
msgstr "每秒一次“什么在哪里”的整理只查看被移除的内容。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTITIONER_CLEANUP.DETAIL"
msgid "The spatial index's cleanup visits only the entries that were removed."
msgstr "空间索引的清理只访问被移除的条目。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTITIONER_EVENTS.TITLE"
msgid "Faster item moves on the map"
msgstr "更快的地图物品移动"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTITIONER_EVENTS.EFFECT"
msgid "An item changing tile no longer looks through every item near it."
msgstr "物品换格时不再查看附近的每一个物品。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PARTITIONER_EVENTS.DETAIL"
msgid "When an item moves or is stored, the game tells the spatial index's listeners for that tile by looking through every item in the surrounding area; items have no listeners, so this skips the look and tidies up the removed entries it would have."
msgstr "物品移动或被存放时，游戏会查看周围区域内的每一个物品，以通知空间索引中该格的监听者；物品没有监听者，因此此项跳过这次查看，并清理它原本会清理的已移除条目。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_CONDUIT_SORTS.TITLE"
msgid "Faster pipe and rail updates"
msgstr "更快的管道和轨道更新"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_CONDUIT_SORTS.EFFECT"
msgid "Pipes and rails no longer re-sort every building's update each second."
msgstr "管道和轨道不再每秒把每个建筑的更新重新排序。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_CONDUIT_SORTS.DETAIL"
msgid "Each second the game sorts the list of pipe and rail buildings by priority again; this repeats the reordering its last sort made while the priorities are the same, which gives the same order."
msgstr "游戏每秒都会把管道和轨道建筑的列表按优先级重新排序；优先级不变时，此项重复上一次排序所做的调整，得到的顺序相同。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_CONVEYOR_PATHS.TITLE"
msgid "Faster conveyor rebuilds"
msgstr "更快的传送带重建"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_CONVEYOR_PATHS.EFFECT"
msgid "Building or removing conveyor rails no longer stalls the game."
msgstr "建造或拆除传送带轨道不再让游戏卡顿。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_CONVEYOR_PATHS.DETAIL"
msgid "The rails' network rebuild finds its routes from an index instead of searching every kept route again."
msgstr "轨道网络重建从索引中查找路线，而不是把保留的每条路线都重新搜索一遍。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PIPE_REBUILDS.TITLE"
msgid "Faster pipe network rebuilds"
msgstr "更快的管道网络重建"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PIPE_REBUILDS.EFFECT"
msgid "Building or removing pipes no longer makes every pipe in the colony check its network."
msgstr "建造或拆除管道不再让殖民地里的每一段管道都检查一遍自己的网络。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_PIPE_REBUILDS.DETAIL"
msgid "After a gas or liquid network changes, only the pipes of that kind recheck whether their network has a building taking from it, all through one handler instead of one or two for every pipe. The status items and the Pipe Flow arrows come out the same."
msgstr "气体或液体网络变化后，只有同类管道会重新检查其网络中是否有从中取用的建筑，并且全部由一个处理程序完成，而不是每段管道各有一到两个。状态提示和管道流向箭头与原版相同。"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.PIPES"
msgid "Each pipe network rebuild ~25 ms shorter on a colony with 27,000 pipes (~57 → ~32 ms)"
msgstr "在有 27,000 段管道的殖民地上，每次管道网络重建缩短约 25 毫秒（约 57 → 约 32 毫秒）"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_NAV_LINKS.TITLE"
msgid "Compact navigation links"
msgstr "紧凑的寻路连接"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_NAV_LINKS.EFFECT"
msgid "The map of where Duplicants and critters can move takes a fraction of the memory."
msgstr "记录复制人和小动物可移动路线的地图只占用一小部分内存。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_NAV_LINKS.DETAIL"
msgid "Each pathfinding grid keeps a cell's moves packed together instead of a fixed row of slots for every cell of the map; the pathfinder reads the same moves in the same order."
msgstr "每个寻路网格把一个格子的移动紧凑地存放在一起，而不是为地图上的每个格子都留出一排固定的位置；寻路读取到的移动及其顺序完全相同。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SMI_LOOKUPS.TITLE"
msgid "Faster state machine lookups"
msgstr "更快的状态机查找"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SMI_LOOKUPS.EFFECT"
msgid "Finding one of an object's state machines no longer searches all of them each time."
msgstr "查找物体的某个状态机时，不再每次都搜索它的全部状态机。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SMI_LOOKUPS.DETAIL"
msgid "Each object remembers which of its state machines answered each lookup until its list of state machines changes."
msgstr "每个物体会记住每次查找由哪个状态机作答，直到它的状态机列表发生变化。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SAVE_ROOTS.TITLE"
msgid "Faster conveyor item moves"
msgstr "更快的传送带物品移动"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SAVE_ROOTS.EFFECT"
msgid "Items moving between rails and buildings no longer search every saved item of their kind."
msgstr "物品在轨道和建筑之间移动时，不再搜索每一个已保存的同类物品。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SAVE_ROOTS.DETAIL"
msgid "When an item is stored, the game takes it out of its list of things to save by comparing it with every item of its kind; this compares references instead, which finds the same entry."
msgstr "物品被存放时，游戏会把它与每一个同类物品逐一比较，以将它从待保存列表中取出；此项改为比较引用，找到的是同一个条目。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PAGED_PATH_GRIDS.TITLE"
msgid "Paged path grids"
msgstr "分页的路径网格"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PAGED_PATH_GRIDS.EFFECT"
msgid "Each Duplicant's map of path costs takes memory only where it can walk."
msgstr "每个复制人的路径消耗地图只在它能走到的地方占用内存。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PAGED_PATH_GRIDS.DETAIL"
msgid "A Duplicant's path grid covers the whole map; it is kept in small pages made the first time a probe writes there, and the parts never written read as the empty grid did. The pathfinder reads the same values."
msgstr "复制人的路径网格覆盖整张地图；它被存放在一个个小页中，某处第一次被寻路探测写入时才创建该页，从未写入的部分读起来和空网格一样。寻路读取到的数值完全相同。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FETCH_BY_CELL.TITLE"
msgid "Fetch checks by pile"
msgstr "按堆检查搬运物品"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FETCH_BY_CELL.EFFECT"
msgid "Duplicants looking for things to fetch check each pile of identical items once, not item by item."
msgstr "复制人寻找要搬运的物品时，每堆相同的物品只检查一次，而不是逐个检查。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FETCH_BY_CELL.DETAIL"
msgid "Keeps the best item of each pile up to date as items move, are reserved or spoil, and finds the path to each pile once. Items on worlds a Duplicant can't reach are skipped. Within a pile of items that are the same in every way the game compares, a Duplicant may take another one than in the original. Off while a mod changes how Duplicants choose what to fetch."
msgstr "在物品移动、被预定或腐坏时随时更新每堆中最好的那一个，并且每堆只寻路一次。复制人到不了的世界上的物品会被跳过。在一堆游戏比较的各方面都相同的物品中，复制人可能会拿走与原版不同的那一个。当有模组改变复制人选择搬运物品的方式时，此项关闭。"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.CONVEYOR"
msgid "No hitch on rail edits (was 0.05–0.5 s)"
msgstr "修改轨道不再卡顿（原本 0.05–0.5 秒）"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PATH_PROBE_REPAIR.TITLE"
msgid "Incremental path probes"
msgstr "增量路径探测"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PATH_PROBE_REPAIR.EFFECT"
msgid "Duplicants' path checks redo only what changed in the world, using less CPU."
msgstr "复制人的寻路检查只重算世界中变化的部分，占用更少的 CPU。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.PATH_PROBE_REPAIR.DETAIL"
msgid "Each Duplicant's last path probe is repaired around what changed (digging, building, doors, liquids) instead of searched again from scratch. Costs and reachable cells stay the same; where two routes cost the same, a Duplicant may walk the other one, not the original's. Keeps about 0.9 MB a Duplicant. Off while another mod changes path probing (Fast Track's Cache Paths)."
msgstr "每个复制人上一次的路径探测只在变化之处（挖掘、建造、门、液体）修补，而不是从头重新搜索。路径代价和可到达的格子不变；两条路线代价相同时，复制人可能走另一条，而不是原版走的那条。每个复制人约占 0.9 MB 内存。其他模组修改路径探测时（如 Fast Track 的 Cache Paths）不生效。"

msgctxt "STRINGS.MOONO.TWEAKS.GROUPS.GRAPHICS"
msgid "Graphics & overlays"
msgstr "图形"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.LAZY_TABLE_REFRESH.TITLE"
msgid "Update only the table rows in sight"
msgstr "只更新可见的表格行"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.LAZY_TABLE_REFRESH.EFFECT"
msgid "Consumables, Vitals, Priorities and the other tables update only the rows on screen each second."
msgstr "消耗品、体征、优先度等表格每秒只更新可见的行。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.LAZY_TABLE_REFRESH.DETAIL"
msgid "Once a second the game updates every row of an open table in one frame: a stutter with many Duplicants. With this, rows out of sight are updated just before they scroll into view, so they show values read then rather than at the last update. Off while a mod changes how tables update."
msgstr "游戏每秒一次在同一帧内更新已打开表格的每一行：复制人多时会造成卡顿。开启后，看不到的行会在滚动进入视野之前才更新，因此它们显示的是那时读取的数值，而不是上一次更新时的数值。当有模组改变表格的更新方式时，此项关闭。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_EVENTS.TITLE"
msgid "Faster animation events"
msgstr "更快的动画事件"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_EVENTS.EFFECT"
msgid "Animations check their sound and effect cues with less work."
msgstr "动画检查音效和特效提示时工作量更少。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_EVENTS.DETAIL"
msgid "Keeps a compact copy of what each playing animation's per-frame event check reads."
msgstr "为每个正在播放的动画保留一份紧凑副本，供其每帧事件检查读取。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_CLEANUP.TITLE"
msgid "Faster animation cleanup"
msgstr "更快的动画清理"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_CLEANUP.EFFECT"
msgid "Removed animations are swept out only where one was removed."
msgstr "被移除的动画只在发生移除的地方被清扫。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_CLEANUP.DETAIL"
msgid "The sweep for destroyed animations skips grid chunks that can't hold any."
msgstr "销毁动画的清扫会跳过不可能含有动画的网格区块。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_BATCHES.TITLE"
msgid "Parallel animation uploads"
msgstr "并行动画上传"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_BATCHES.EFFECT"
msgid "Animation data for the graphics card is prepared on several threads."
msgstr "显卡所需的动画数据在多个线程上准备。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_ANIM_BATCHES.DETAIL"
msgid "Animation batches write their instance and symbol data on worker threads, the rest in the game's order."
msgstr "动画批次在工作线程上写入实例和符号数据，其余按游戏原有顺序进行。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SYMBOL_OVERRIDES.TITLE"
msgid "Fewer animation uploads"
msgstr "更少的动画上传"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SYMBOL_OVERRIDES.EFFECT"
msgid "Swapped animation parts are re-sent to the graphics card only when they change."
msgstr "被替换的动画部件只在变化时才重新发送到显卡。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_SYMBOL_OVERRIDES.DETAIL"
msgid "Unchanged symbol-override blocks of Duplicants and buildings aren't uploaded again."
msgstr "复制人和建筑未变的符号覆盖块不再重复上传。"

msgctxt "STRINGS.MOONO.TWEAKS.GROUPS.CHANGES_GAMEPLAY"
msgid "Changes gameplay"
msgstr "改变玩法"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.INSTANT_REACHABILITY.TITLE"
msgid "Instant reachability checks"
msgstr "即时可达性检查"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.INSTANT_REACHABILITY.EFFECT"
msgid "Duplicants notice a newly opened or blocked path at once, using less CPU."
msgstr "复制人立即察觉新打开或被阻断的路径，并且占用更少的 CPU。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.INSTANT_REACHABILITY.DETAIL"
msgid "Which errands and items can be reached is rechecked where and when a Duplicant's reach changes, instead of every one of them once a second. The answers are the game's, up to 1 s sooner. Items it can't follow (some mods' own) are still checked every second."
msgstr "哪些任务和物品可达，只在复制人可达范围发生变化的地方、变化的那一刻重新检查，而不是每秒把所有任务和物品都检查一遍。结果与游戏本身相同，只是最多提前 1 秒得到。无法跟踪的物品（部分模组自己的）仍每秒检查一次。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_SCREEN_CONVEYORS.TITLE"
msgid "Lazy unseen conveyor items"
msgstr "屏幕外传送带物品延迟处理"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_SCREEN_CONVEYORS.EFFECT"
msgid "Items riding rails off screen are placed only when they stop or come into view."
msgstr "屏幕外轨道上的物品只在停下或进入视野时才放置。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_SCREEN_CONVEYORS.DETAIL"
msgid "The rails carry exactly the same things, but items' positions lag while off screen."
msgstr "轨道运送的东西完全相同，但物品位置在屏幕外会滞后。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_WORLD_FALLERS.TITLE"
msgid "Land items lost below a world"
msgstr "让掉出世界底部的物品落地"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_WORLD_FALLERS.EFFECT"
msgid "Items that fall out the bottom of a world (a rocket's chute) stop falling forever."
msgstr "掉出世界底部（火箭发射井）的物品不再无限下落。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.OFF_WORLD_FALLERS.DETAIL"
msgid "A bug in the game: they hang just below the world, stepped as falling every tick. This lands them where they hang."
msgstr "这是游戏的错误：它们会悬在世界正下方，每个 tick 都按下落步进。开启后让它们停在悬挂处。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.BRAIN_RATE.TITLE"
msgid "Critter and dupe brain updates capped at 30 updates a second"
msgstr "小动物和复制人脑更新上限为每秒 30 次"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.BRAIN_RATE.EFFECT"
msgid "Critters and dupes would otherwise update on every frame. This trims that bookkeeping above 30 fps."
msgstr "小动物和复制人原本每帧都会更新。此项在 30 fps 以上削减这部分簿记开销。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.BRAIN_RATE.DETAIL"
msgid "The game updates 1 Duplicant and 5 critter brains every rendered frame; this caps them at 30 and 150 a second, spread over frames. One that just finished an errand or is under threat still gets the next update. Saves time only above 30 fps."
msgstr "游戏每渲染帧更新 1 个复制人和 5 个小动物的脑；此项将其限制为每秒 30 和 150 次，并分摊到各帧。刚完成任务或受到威胁的个体仍会立即获得下一次更新。仅在 30 fps 以上节省时间。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.RENDERER.TITLE"
msgid "Renderer"
msgstr "渲染器"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.RENDERER.EFFECT"
msgid "Which graphics API the game draws with. Needs a restart."
msgstr "游戏使用哪种图形 API 绘制。需要重启。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.RENDERER.DETAIL"
msgid "Auto: Vulkan, or OpenGL when Vulkan can't start on this PC. Vulkan: Vulkan whenever it starts (also a software one). OpenGL: the original game's API. The picture is the same; Player.log names the one used and why."
msgstr "自动：使用 Vulkan，若此电脑上 Vulkan 无法启动则使用 OpenGL。Vulkan：只要能启动就使用 Vulkan（包括软件实现）。OpenGL：原版游戏使用的 API。画面相同；Player.log 会写明使用了哪一个以及原因。"

msgctxt "STRINGS.MOONO.TWEAKS.CHOICES.RENDERER.AUTO"
msgid "auto"
msgstr "自动"

msgctxt "STRINGS.MOONO.TWEAKS.CHOICES.RENDERER.VULKAN"
msgid "vulkan"
msgstr "vulkan"

msgctxt "STRINGS.MOONO.TWEAKS.CHOICES.RENDERER.OPENGL"
msgid "opengl"
msgstr "opengl"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.DXGI.TITLE"
msgid "Present through Direct3D on Windows"
msgstr "Windows 上通过 Direct3D 显示"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.DXGI.EFFECT"
msgid "Windows shows the game as it shows the original: no forced HDR or brightness. Needs a restart."
msgstr "Windows 像显示原版一样显示游戏：不会被强制开启 HDR 或调高亮度。需要重启。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.DXGI.DETAIL"
msgid "With Vulkan or OpenGL, frames go to the screen through a Direct3D 11 swap chain, as the original's do. Off: through the renderer's own presentation, which Auto HDR or RTX HDR can take for HDR. If it can't start, the renderer's own is used and Player.log says why. No effect on Linux."
msgstr "无论使用 Vulkan 还是 OpenGL，画面都像原版一样通过 Direct3D 11 交换链送到屏幕。关闭时使用渲染器自身的呈现方式，可能被自动 HDR 或 RTX HDR 当作 HDR 内容。无法启动时改用渲染器自身的方式，Player.log 会说明原因。在 Linux 上无效。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.STALL_REPEATS.TITLE"
msgid "Steady display during saves and loads"
msgstr "存档和读档时保持画面稳定"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.STALL_REPEATS.EFFECT"
msgid "G-Sync and FreeSync monitors don't flicker while the game saves or loads."
msgstr "游戏存档或读档时，G-Sync 和 FreeSync 显示器不会闪烁。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.STALL_REPEATS.DETAIL"
msgid "While no new frame comes for a moment, the last one is shown again at about the game's frame rate (30 to 60 times a second), so the monitor's refresh rate doesn't drop. Nothing changes while frames come as usual. Windows, with Direct3D presentation on."
msgstr "当一段时间没有新画面时，以接近游戏帧率的频率（每秒 30 到 60 次）重复显示上一帧，使显示器的刷新率不会骤降。画面正常到来时不做任何改变。仅限 Windows，且需开启 Direct3D 显示。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.GC.TITLE"
msgid "Garbage collection"
msgstr "垃圾回收"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.GC.EFFECT"
msgid "How the game frees memory it no longer uses. Needs a restart."
msgstr "游戏如何释放不再使用的内存。需要重启。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.GC.DETAIL"
msgid "Fast (default): collects garbage on all cores, with rare, short pauses, but uses more memory. Low memory: uses less RAM (about 0.8 GB less on a large colony), but pauses more often and loads more slowly. Only worth changing if your PC is short on RAM."
msgstr "快速（默认）：在所有 CPU 核心上回收垃圾，暂停少且短，但占用更多内存。低内存：占用更少内存（大型殖民地约少 0.8 GB），但暂停更频繁、读档更慢。只有在电脑内存不足时才值得更改。"

msgctxt "STRINGS.MOONO.TWEAKS.CHOICES.GC.FAST"
msgid "fast"
msgstr "快速"

msgctxt "STRINGS.MOONO.TWEAKS.CHOICES.GC.LOW_MEMORY"
msgid "low memory"
msgstr "低内存"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_LOAD_SCREEN.TITLE"
msgid "Faster Load screen"
msgstr "更快的加载游戏界面"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_LOAD_SCREEN.EFFECT"
msgid "With many saves, the Load screen opens and loads more colonies sooner."
msgstr "存档很多时，加载游戏界面打开和“加载更多”都更快。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FAST_LOAD_SCREEN.DETAIL"
msgid "Each save's details are read from its file once a refresh instead of four times, several files at a time, and the previews of pages already shown are not made again. The colonies, their order, the previews and the log are the same."
msgstr "每次刷新时每个存档的信息只从文件读取一次而不是四次，并且同时读取多个文件；已显示页面的预览图不再重新生成。殖民地、顺序、预览图和日志都不变。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.LOADING_ANIMATION.TITLE"
msgid "Moving loading screen"
msgstr "会动的加载画面"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.LOADING_ANIMATION.EFFECT"
msgid "The loading screen keeps moving while a colony loads."
msgstr "加载殖民地时，加载画面不再静止不动。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.LOADING_ANIMATION.DETAIL"
msgid "A save loads in one long step during which the game shows no new picture, for half a minute on a large colony. Meanwhile Moono keeps the loading screen moving, with a progress bar, and plays animated loading art from mods such as Loading Pip. The load itself is the same and takes as long."
msgstr "读取存档是一个漫长的步骤，期间游戏不会显示新画面，大型殖民地可长达半分钟。这段时间里 Moono 会让加载画面保持动态并显示进度条，还会播放模组提供的动画加载图（如 Loading Pip）。加载过程本身不变，耗时也相同。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FMOD_QUARANTINE.TITLE"
msgid "Sound memory guard"
msgstr "音效内存保护"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FMOD_QUARANTINE.EFFECT"
msgid "Guards against a bug in the game's sound engine that can crash the game."
msgstr "防范游戏音效引擎中一个可能导致游戏崩溃的错误。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FMOD_QUARANTINE.DETAIL"
msgid "FMOD, the sound engine, can write to memory it has already freed, a bug its makers confirmed, behind some \"heap corruption\" crashes. With this, FMOD gets memory of its own and freed memory waits a while before reuse, so a late write lands where nothing else is, and Player.log notes each one found. Uses about 90 MB more memory on a large colony. Windows only for now."
msgstr "游戏的音效引擎 FMOD 可能会写入已经释放的内存，这是其开发者已确认的错误，也是部分“堆损坏”崩溃的原因。开启后，FMOD 使用自己的内存，释放的内存要等一段时间才会被重新使用，因此迟到的写入只会落在无人使用的地方，并且 Player.log 会记录发现的每一次。在大型殖民地上约多用 90 MB 内存。目前仅限 Windows。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FMOD_STEAL_FIX.TITLE"
msgid "Stolen sound crash guard"
msgstr "被抢占声音的崩溃防护"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FMOD_STEAL_FIX.EFFECT"
msgid "Fixes a bug in the game's sound engine that can crash the game when many sounds play at once."
msgstr "修复游戏音效引擎中一个在同时播放大量声音时可能导致游戏崩溃的错误。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FMOD_STEAL_FIX.DETAIL"
msgid "When too many copies of a sound play, FMOD, the sound engine, stops the oldest; if that one is still loading, FMOD frees it and then writes to it. With this, that one write is skipped, in FMOD's code in memory, only for the exact FMOD files the game ships; anything else is left as it is. Nothing you hear changes."
msgstr "同一声音播放的份数过多时，音效引擎 FMOD 会停掉最早的那一份；如果那一份还在加载，FMOD 会先释放它，然后又向它写入。开启后会在内存中的 FMOD 代码里跳过这一次写入，且仅针对游戏自带的那几个 FMOD 文件；其他情况一律保持原样。你听到的声音不会有任何变化。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_RELEASED_SOUNDS.TITLE"
msgid "Forget released sounds"
msgstr "忘掉已释放的声音"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_RELEASED_SOUNDS.EFFECT"
msgid "The game stops changing sounds it is done with, which after hours of play could crash it."
msgstr "游戏不再改动它已经用完的声音，这在游玩数小时后可能导致崩溃。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_RELEASED_SOUNDS.DETAIL"
msgid "A bug in the game's own code: background sounds, and looping sounds after a switch to another asteroid, keep the sound engine's number for a sound the game is done with, and go on using it. After a couple of hours on a large colony the sound engine gives that number to something else, and the game's change lands there, sometimes not on a sound at all. With this, the number is forgotten when the sound is let go. Nothing you hear changes."
msgstr "这是游戏自身代码的错误：背景声音，以及切换到另一颗小行星后的循环声音，会留着音效引擎给某个已用完的声音分配的编号，并继续使用它。在大型殖民地上玩几个小时后，音效引擎会把这个编号分给别的东西，游戏的改动就落到那里，有时根本不是一个声音。开启后，声音被放掉时就忘掉这个编号。你听到的声音不会有任何变化。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.EXACT_WORLDGEN.TITLE"
msgid "Worldgen as in the original"
msgstr "与原版一致的世界生成"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.EXACT_WORLDGEN.EFFECT"
msgid "A seed makes the same map as in the original game, so shared seeds match."
msgstr "同一种子生成与原版游戏相同的地图，分享的种子可以对得上。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.EXACT_WORLDGEN.DETAIL"
msgid "Worldgen does its decimal maths at the precision the original game uses, rounding only where a value is kept. Off: biome borders on a new map can come out slightly different. Maps already generated and saves are not affected."
msgstr "世界生成的小数运算采用原版游戏的精度，只在保存数值时取整。关闭时：新地图的生态区边界可能略有不同。已生成的地图和存档不受影响。"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.LOAD_SCREEN"
msgid "Load screen with 4,637 saves opens in ~0.6 s (was ~1.4 s)"
msgstr "4,637 个存档时加载游戏界面约 0.6 秒打开（原本约 1.4 秒）"

msgctxt "STRINGS.MOONO.TWEAKS.GROUPS.BUG_FIXES"
msgid "Bug fixes"
msgstr "错误修复"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_LOAD_SCREEN_CLICKS.TITLE"
msgid "Open a colony once on the Load screen"
msgstr "加载游戏界面中殖民地只打开一次"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_LOAD_SCREEN_CLICKS.EFFECT"
msgid "After Load more, a click on a colony no longer builds its list of saves again for every refresh."
msgstr "点击“加载更多”后，点击殖民地不再为每次刷新各重建一遍它的存档列表。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_LOAD_SCREEN_CLICKS.DETAIL"
msgid "A bug in the game's own code: each Load more adds another copy of the click to the colonies already shown, so one click builds the colony once for every refresh, and the last one stays on screen. With this, one click builds it once and logs once; the screen ends up the same."
msgstr "这是游戏自身代码的错误：每次“加载更多”都会给已显示的殖民地再添加一份点击处理，于是一次点击会按刷新次数重复构建殖民地，屏幕上留下最后一次的结果。开启后一次点击只构建一次、只记录一次日志；界面最终相同。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_SOUND_PILES.TITLE"
msgid "Cap repeated sounds in one tile"
msgstr "限制同一格内的重复声音"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_SOUND_PILES.EFFECT"
msgid "Hundreds of critters in one tile no longer freeze the game with their sounds."
msgstr "同一格内的数百只小动物不再因它们的声音让游戏卡死。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_SOUND_PILES.DETAIL"
msgid "When more than 3 copies of the same sound start in the same tile in the same frame, the rest are skipped. A big pile of critters sounds quieter; anywhere else this almost never happens. UI and looping sounds are never skipped."
msgstr "同一帧内同一格开始播放同一声音超过 3 份时，其余的会被跳过。一大堆小动物听起来会更安静；在其他地方这几乎不会发生。界面声音和循环声音从不跳过。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.TRIM_ANIM_LISTS.TITLE"
msgid "Trimmed animation lists"
msgstr "精简的动画列表"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.TRIM_ANIM_LISTS.EFFECT"
msgid "The game's animation data takes about 65 MB less memory."
msgstr "游戏的动画数据少占约 65 MB 内存。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.TRIM_ANIM_LISTS.DETAIL"
msgid "Once the animations are loaded, the lists of their frames and frame parts give back the room they grew into but don't use; the game reads the same data."
msgstr "动画加载完成后，其帧和帧部件的列表会交还增长时多占却不用的空间；游戏读取的数据不变。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.POST_LOAD_GC.TITLE"
msgid "Memory cleanup during loading"
msgstr "加载时清理内存"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.POST_LOAD_GC.EFFECT"
msgid "Collects garbage during the loading screen, avoiding a large hitch shortly after the game starts."
msgstr "在加载画面仍显示时回收内存，进入游戏后不久不会出现明显卡顿。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.POST_LOAD_GC.DETAIL"
msgid "Runs the memory cleanup that would otherwise pause the game about a minute into play at the end of the load, while the game is still paused. Only with Fast garbage collection (the default)."
msgstr "在加载结束、游戏仍处于暂停时进行原本会在开始游玩约一分钟后造成卡顿的内存清理。仅在“快速”垃圾回收（默认）下生效。"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.FETCH"
msgid "Fetch updates ~8× shorter on a colony with big piles (3.1–3.4 → 0.4 ms each)"
msgstr "在物品成堆的殖民地上，搬运检查缩短约 8 倍（每次 3.1–3.4 → 0.4 毫秒）"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.POST_LOAD"
msgid "No ~0.3 s freeze a minute after loading a large colony; loading ~0.2 s longer"
msgstr "加载大型殖民地约一分钟后不再有约 0.3 秒的冻结；加载时间延长约 0.2 秒"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_TIMELAPSE_SNAPSHOTS.TITLE"
msgid "Correct daily colony snapshots"
msgstr "修正每日殖民地快照"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_TIMELAPSE_SNAPSHOTS.EFFECT"
msgid "Colony snapshots saved each cycle no longer get vertical stripes, squeezed lights or stray effects."
msgstr "每个周期保存的殖民地快照不再出现竖条纹、被挤压的光照或错位的效果。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_TIMELAPSE_SNAPSHOTS.DETAIL"
msgid "A bug in the game's own code: a snapshot is drawn into a narrow image, but the build grid, the lights and the heat, cold and dust effects are set up for the screen's wider view. With a building picked for placement, the grid draws stripes over the left of the image. With this, they are drawn for the snapshot's own view."
msgstr "这是游戏自身代码的错误：快照绘制在一张较窄的图像中，但建造网格、光照以及热、冷和灰尘效果都是按屏幕较宽的视野设置的。选中建筑准备放置时，网格会在图像左侧画出条纹。开启后，它们按快照自己的视野绘制。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_TABLE_SCROLL.TITLE"
msgid "Keep table columns where they were scrolled"
msgstr "让表格列保持在滚动到的位置"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_TABLE_SCROLL.EFFECT"
msgid "Scrolled table columns no longer jump back to the first ones every second or so."
msgstr "滚动过的表格列不再每隔一秒左右跳回最前面的几列。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.FIX_TABLE_SCROLL.DETAIL"
msgid "A bug in the game's own code: each row of a table keeps its own scroll position in step with the others, and when the rows are laid out again (as they are every second or so while the columns move), one row's columns go back to the start and the game moves every row there. With this, laying out a row keeps the table's scroll position."
msgstr "这是游戏自身代码的错误：表格的每一行各自保存滚动位置并与其他行保持同步，当各行重新布局时（列移动期间每隔一秒左右就会发生一次），某一行的列会回到开头，游戏随即把每一行都移到那里。开启后，重新布局某一行时会保持表格的滚动位置。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SHARED_DUPLICATES.TITLE"
msgid "Share identical data"
msgstr "共享相同的数据"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SHARED_DUPLICATES.EFFECT"
msgid "Names repeated across a colony's reports and other identical data are kept once, using less memory."
msgstr "殖民地报告中反复出现的名字和其他相同的数据只保留一份，占用更少内存。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SHARED_DUPLICATES.DETAIL"
msgid "While a save loads, every copy of the same text (Duplicants' and critters' names in each day's report) becomes one; buildings with the same footprint share one table of the spots they are worked from, and work animations left at their defaults share one list. Nothing is written into them, so the game reads the same values."
msgstr "加载存档时，同一段文字的所有副本（每日报告中复制人和小动物的名字）合并为一份；占地相同的建筑共用一张可操作位置表，保持默认值的工作动画共用一个列表。这些数据从不被写入，因此游戏读到的数值完全相同。"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.SHARED"
msgid "~0.3 GB less memory on a late-game colony"
msgstr "后期大型殖民地少用约 0.3 GB 内存"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_REPORT_HISTORY.TITLE"
msgid "Compact report history"
msgstr "紧凑的报告历史"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_REPORT_HISTORY.EFFECT"
msgid "Past days' reports take a fraction of the memory."
msgstr "往日的报告只占原来一小部分的内存。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.COMPACT_REPORT_HISTORY.DETAIL"
msgid "The notes of every day's report but today's are kept in flat arrays instead of a table for each entry; the reports screen and saves read the same notes in the same order."
msgstr "除今天以外，每日报告的备注都存放在紧凑的数组中，而不是每个条目各占一张表；报告界面和存档读到的备注及其顺序完全相同。"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.REPORTS"
msgid "~0.9 GB less memory on a late-game colony; loading ~1 s faster"
msgstr "后期大型殖民地少用约 0.9 GB 内存，加载快约 1 秒"

msgctxt "STRINGS.MOONO.LOADER.TITLE"
msgid "Play with Moono?"
msgstr "使用 Moono 游玩？"

msgctxt "STRINGS.MOONO.LOADER.INTRO"
msgid "Moono makes Oxygen Not Included run faster. To play with it:"
msgstr "Moono 让《缺氧》运行得更快。使用方法："

msgctxt "STRINGS.MOONO.LOADER.STEP_COPY"
msgid "Click Copy launch option. This installs Moono and copies:"
msgstr "点击“复制启动选项”。这会安装 Moono 并复制："

msgctxt "STRINGS.MOONO.LOADER.STEP_PASTE"
msgid "In Steam, right-click Oxygen Not Included → Properties → Launch Options, and paste."
msgstr "在 Steam 中右键点击《缺氧》→ 属性 → 启动选项，然后粘贴。"

msgctxt "STRINGS.MOONO.LOADER.STEP_RESTART"
msgid "Quit the game and press Play."
msgstr "退出游戏，然后点击“开始游戏”。"

msgctxt "STRINGS.MOONO.LOADER.DISABLE_HINT"
msgid "To stop seeing this, disable the Moono mod."
msgstr "如不想再看到此窗口，请停用 Moono 模组。"

msgctxt "STRINGS.MOONO.LOADER.NOT_NOW"
msgid "Not now"
msgstr "以后再说"

msgctxt "STRINGS.MOONO.LOADER.COPY"
msgid "Copy launch option"
msgstr "复制启动选项"

msgctxt "STRINGS.MOONO.LOADER.COPIED"
msgid "Copied ✓"
msgstr "已复制 ✓"

msgctxt "STRINGS.MOONO.LOADER.INSTALLED"
msgid "Moono installed. Launch option copied."
msgstr "Moono 已安装，启动选项已复制。"

msgctxt "STRINGS.MOONO.LOADER.FAILED"
msgid "Moono could not be installed: {0}"
msgstr "无法安装 Moono：{0}"

msgctxt "STRINGS.MOONO.LOADER.MODS_BUTTON"
msgid "Play with Moono"
msgstr "使用 Moono"

msgctxt "STRINGS.MOONO.LOADER.MODS_TIP"
msgid "Install Moono and copy the launch option for Steam"
msgstr "安装 Moono 并复制 Steam 启动选项"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SIM_STEP_PACE.TITLE"
msgid "Simulation at its own pace"
msgstr "按模拟自身的节奏运行"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SIM_STEP_PACE.EFFECT"
msgid "Above 60 fps at normal speed, frames no longer wait for the simulation, and it uses less CPU."
msgstr "在正常速度下超过 60 fps 时，帧不再等待模拟，CPU 占用也更少。"

msgctxt "STRINGS.MOONO.TWEAKS.ROWS.SIM_STEP_PACE.DETAIL"
msgid "Between its steps, five a second, the game asks the simulation for its state on every frame with no game time to step, which happens only above 60 fps at normal speed. Each such call makes the frame wait for the step underway and runs a step of no time. With this, the simulation is called only at its steps, as the game already does below 60 fps and at faster speeds. Dug tiles, built tiles and other changes the game asks of the simulation then show about 0.3 s later than without it (up to 0.4 s), as below 60 fps. Paused, or while another mod changes these calls, the game's own calls run."
msgstr "在两次模拟步进之间（每秒五次），游戏会在每个没有游戏时间可推进的帧上向模拟查询其状态，这只会在正常速度下超过 60 fps 时发生。每次这样的调用都会让该帧等待正在进行的步进，并运行一次零时间的步进。启用后，模拟只在其步进时被调用，与游戏在 60 fps 以下和更快速度下的做法相同。挖掉的格子、建成的格子以及游戏对模拟提出的其他改动，随之比不启用时晚约 0.3 秒显示（最多 0.4 秒），与 60 fps 以下相同。暂停时，或有其他模组修改这些调用时，仍运行游戏自身的调用。"

msgctxt "STRINGS.MOONO.TWEAKS.GAINS.PACE"
msgid "112 → 220 fps at normal speed on a large modded colony"
msgstr "大型模组殖民地在正常速度下 112 → 220 fps"
