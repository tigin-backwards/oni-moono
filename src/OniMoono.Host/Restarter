#!/bin/sh
# Restarter EXECUTABLE [ARGUMENT...]: the helper the game's App.Restart starts from the player's
# directory (Klei ships one next to their player) before quitting, e.g. after a language change.
# Once the player has exited, the executable is started again with the arguments the player was
# started with, which the host records in ONI_MOONO_RESTART_ARGS (shell-quoted). The Linux
# App.Restart passes only the executable (761654's Windows one adds the arguments); any given
# are used without the record.
exe="$1"; shift
while kill -0 "$PPID" 2>/dev/null; do sleep 0.2; done
[ -n "${ONI_MOONO_RESTART_ARGS+set}" ] && eval "set -- $ONI_MOONO_RESTART_ARGS"
exec "$exe" "$@"
