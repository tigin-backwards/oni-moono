<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The engine-side bridge the shipped TextMeshPro calls into (Unity's
         Unity.InternalAPIEngineBridge.004, version 0.0.0.0). It reaches engine internals. -->
    <AssemblyName>Unity.InternalAPIEngineBridge.004</AssemblyName>
    <RootNamespace>TMPro</RootNamespace>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OniMoono.UnityEngine/OniMoono.UnityEngine.csproj" />
    <!-- Comparisons of engine records and facades by reference (IdentityAnalyzer). -->
    <ProjectReference Include="../OniMoono.Analyzers/OniMoono.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
