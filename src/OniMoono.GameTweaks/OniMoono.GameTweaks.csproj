<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game tweaks that need the game's own types (docs/PLAN.md "Game tweaks"), and the main menu's
       Moono Tweaks screen that chooses them (MoonoTweaksMenu): built against the game's
       assemblies like a mod, loaded by the host at start-up; a tweak's patches are made only when
       it is on. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OniManaged>$(OniGameDir)/OxygenNotIncluded_Data/Managed</OniManaged>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tweaks' declarations of the game members they use and their transpilers' counts
         (TweakChecks, TweakInstall in the host), one source for both assemblies. -->
    <Compile Include="../OniMoono.Host/GameTweaks/GameMemberAttribute.cs" Link="GameMemberAttribute.cs" />
  </ItemGroup>
  <!-- The game's own assemblies are publicized for the compiler (Krafs.Publicizer: copies in
       obj/ with every member public), so the tweaks reach the game's private members directly,
       and IgnoresAccessChecksTo lets the runtime allow it. Virtual members stay as they are, so
       an override keeps its access (MoonoTweaksScreen's), and compiler-generated ones too
       (event backing fields would clash with their events). The reference scan (TweakChecks)
       covers these references like any other. -->
  <PropertyGroup>
    <PublicizerRuntimeStrategies>IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Assembly-CSharp-firstpass" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <!-- MoonoTweaksScreen's own `shown` would hide it. -->
    <DoNotPublicize Include="Assembly-CSharp:KModalScreen.shown" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(OniManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(OniManaged)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(OniManaged)/0Harmony.dll" Private="false" />
    <!-- The game's JSON writer, for the colony summary a save writes (ColonySummaryWrite). -->
    <Reference Include="$(OniManaged)/Newtonsoft.Json.dll" Private="false" />
    <!-- FMOD's event descriptions and instances, for the sound fixes. -->
    <Reference Include="$(OniManaged)/FMODUnity.dll" Private="false" />
    <!-- The screen's widgets (LocText is a TextMeshProUGUI, KImage a UI Image): bound at run time
         to this project's UI packages, as the game's own assemblies are. -->
    <Reference Include="$(OniManaged)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(OniManaged)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(OniManaged)/UnityEngine.UIModule.dll" Private="false" />
    <!-- TextAnchor, for the update badge's layout groups. -->
    <Reference Include="$(OniManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>
</Project>
